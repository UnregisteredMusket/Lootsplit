<?xml version="1.0" encoding="utf-8"?>
<!-- Strip below the tiles: daily report status and agent activity (the development task with its timer when one is active). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="2dp" android:paddingBottom="3dp" android:orientation="horizontal" android:baselineAligned="false" android:background="#071712">
    <LinearLayout android:id="@+id/strip_report" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="40dp" android:orientation="vertical" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:background="@drawable/item_tile_dark">
        <TextView android:id="@+id/strip_report_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DAILY REPORT" android:textSize="10sp" android:letterSpacing="0.06" android:textColor="#7AA68D" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/strip_report_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="10sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/strip_agent" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="40dp" android:layout_marginStart="5dp" android:orientation="vertical" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:background="@drawable/item_tile_dark">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
            <TextView android:id="@+id/strip_agent_key" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="AGENT ACTIVITY" android:textSize="10sp" android:letterSpacing="0.06" android:textColor="#7AA68D" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <Chronometer android:id="@+id/strip_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textSize="10sp" android:textStyle="bold" android:textColor="#13F580" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/strip_agent_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="10sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
