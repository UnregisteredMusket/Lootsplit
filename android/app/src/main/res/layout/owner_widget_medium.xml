<?xml version="1.0" encoding="utf-8"?>
<!-- Field monitor 4×2 (redesign approved 2026-10-25): header, status, the most severe active item (or the latest recovery) and
     three mini tiles (requests with errors on their own baseline, worst plan-usage gauge with pace, last main runs).
     Below ~150 dp tall the tiles are hidden. -->
<FrameLayout android:id="@+id/monitor_root" xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/monitor_background" android:paddingStart="12dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
            <TextView android:id="@+id/monitor_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="LOOTSPLITTER ▸ FIELD MONITOR" android:textSize="10.5sp" android:textColor="#13F580" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/monitor_checked" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="—" android:textSize="10sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1"/>
            <TextView android:id="@+id/monitor_refresh" android:layout_width="40dp" android:layout_height="32dp" android:layout_marginStart="6dp" android:background="@drawable/monitor_button" android:gravity="center" android:text="↻" android:textSize="13sp" android:textStyle="bold" android:textColor="#13F580" android:fontFamily="monospace" android:contentDescription="Refresh owner monitoring"/>
        </LinearLayout>

        <!-- Status: glyph box, status word with "since 10:41 · active 31m", severity counts (✕ ! i; a zero count is dimmed). -->
        <LinearLayout android:id="@+id/monitor_status" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
            <TextView android:id="@+id/monitor_glyph" android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/glyph_box_none" android:text="–" android:textSize="14sp" android:textStyle="bold" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center" android:includeFontPadding="false" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:orientation="vertical">
                <TextView android:id="@+id/monitor_health" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SIGN IN REQUIRED" android:textSize="15sp" android:textColor="#EEC771" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:letterSpacing="0.03"/>
                <TextView android:id="@+id/monitor_since" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textSize="10sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/monitor_counts" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:orientation="horizontal">
                <TextView android:id="@+id/monitor_count_crit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/chip_border" android:text="✕–" android:textSize="10sp" android:textStyle="bold" android:textColor="#F47272" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" />
                <TextView android:id="@+id/monitor_count_warn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/chip_border" android:text="!–" android:textSize="10sp" android:textStyle="bold" android:textColor="#EEC771" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" />
                <TextView android:id="@+id/monitor_count_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/chip_border" android:text="i–" android:textSize="10sp" android:textStyle="bold" android:textColor="#8CC4F2" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/medium_item" android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginTop="3dp" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="6dp" android:background="@drawable/item_tile_dark">
            <TextView android:id="@+id/medium_item_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="44dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/chip_border" android:gravity="center" android:textSize="9sp" android:textStyle="bold" android:textColor="#EEC771" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1"/>
            <TextView android:id="@+id/medium_item_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:textSize="10sp" android:textColor="#E6F8EC" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/medium_tiles" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:id="@+id/medium_tile_req" android:layout_width="0dp" android:layout_weight="1.25" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/item_tile_dark">
                <TextView android:id="@+id/medium_req_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="REQ 24H" android:textSize="8.5sp" android:letterSpacing="0.08" android:textColor="#7AA68D" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1"/>
                <TextView android:id="@+id/medium_req_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="—" android:textSize="11sp" android:textStyle="bold" android:textColor="#E6F8EC" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
                <ImageView android:id="@+id/medium_req_chart" android:layout_width="match_parent" android:layout_height="26dp" android:layout_marginTop="2dp" android:scaleType="fitXY" android:visibility="gone"/>
                <TextView android:id="@+id/medium_req_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="9sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/medium_tile_usage" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="5dp" android:orientation="vertical" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/item_tile_dark">
                <TextView android:id="@+id/medium_usage_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="USAGE" android:textSize="8.5sp" android:letterSpacing="0.08" android:textColor="#7AA68D" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1"/>
                <TextView android:id="@+id/medium_usage_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="—" android:textSize="11sp" android:textStyle="bold" android:textColor="#E6F8EC" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
                <FrameLayout android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="3dp">
                    <ProgressBar android:id="@+id/medium_usage_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_gravity="center_vertical" android:max="100" android:progressDrawable="@drawable/gauge_ok" android:indeterminate="false" android:importantForAccessibility="no"/>
                    <ProgressBar android:id="@+id/medium_usage_hot" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_gravity="center_vertical" android:max="100" android:progressDrawable="@drawable/gauge_hot" android:indeterminate="false" android:visibility="gone" android:importantForAccessibility="no"/>
                    <ImageView android:id="@+id/medium_usage_pace" android:layout_width="match_parent" android:layout_height="12dp" android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no"/>
                </FrameLayout>
                <TextView android:id="@+id/medium_usage_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="9sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/medium_tile_main" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="5dp" android:orientation="vertical" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/item_tile_dark">
                <TextView android:id="@+id/medium_main_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MAIN" android:textSize="8.5sp" android:letterSpacing="0.08" android:textColor="#7AA68D" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1"/>
                <TextView android:id="@+id/medium_main_pips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.15" android:textColor="#B1D6C1" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1"/>
                <TextView android:id="@+id/medium_main_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="9sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
