<?xml version="1.0" encoding="utf-8"?>
<!-- Recently resolved line (✓ title · start → end · duration · resolved), or a short note. Expands to its history. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="28dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:orientation="vertical" android:gravity="center_vertical" android:background="#071712">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
        <TextView android:id="@+id/resolved_glyph" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓" android:textSize="10sp" android:textStyle="bold" android:textColor="#13F580" android:fontFamily="monospace" android:includeFontPadding="false" android:importantForAccessibility="no" />
        <TextView android:id="@+id/resolved_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="9.5sp" android:textColor="#E6F8EC" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/resolved_line" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="9.5sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" />
        <TextView android:id="@+id/resolved_chevron" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="▾" android:textSize="10sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:includeFontPadding="false" android:importantForAccessibility="no" />
    </LinearLayout>
    <TextView android:id="@+id/resolved_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="3dp" android:textSize="9.5sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:visibility="gone" />
</LinearLayout>
