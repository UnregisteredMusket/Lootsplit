<?xml version="1.0" encoding="utf-8"?>
<!-- One attention item: severity chip (✕ CRIT / ! WARN / i INFO), title, ACTIVE tag, meta line (evidence · started · duration).
     Tapping expands it in place (item_more): severity reason, timing, evidence, 6-hour error chart, next action and links. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:orientation="vertical" android:background="#071712">
    <LinearLayout android:id="@+id/item_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/item_tile_dark">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
            <TextView android:id="@+id/item_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="44dp" android:layout_marginTop="1dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/chip_border" android:gravity="center" android:text="! WARN" android:textSize="9sp" android:textStyle="bold" android:textColor="#EEC771" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
                    <TextView android:id="@+id/item_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" android:textColor="#E6F8EC" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/item_tag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:text="ACTIVE" android:textSize="8.5sp" android:textStyle="bold" android:letterSpacing="0.06" android:textColor="#071712" android:background="#EEC771" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" />
                    <TextView android:id="@+id/item_chevron" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="▾" android:textSize="11sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:includeFontPadding="false" android:importantForAccessibility="no" />
                </LinearLayout>
                <TextView android:id="@+id/item_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="9.5sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/item_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/item_lines" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="9.5sp" android:lineSpacingExtra="1dp" android:textColor="#E6F8EC" android:fontFamily="monospace" />
            <ImageView android:id="@+id/item_chart" android:layout_width="match_parent" android:layout_height="26dp" android:layout_marginTop="4dp" android:scaleType="fitXY" android:visibility="gone" />
            <LinearLayout android:id="@+id/item_axis" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone" android:importantForAccessibility="no">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="-6h" android:textSize="8sp" android:textColor="#7AA68D" android:fontFamily="monospace" android:id="@+id/item_axis_start" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="now" android:textSize="8sp" android:textColor="#7AA68D" android:fontFamily="monospace" android:id="@+id/item_axis_end" />
            </LinearLayout>
            <TextView android:id="@+id/item_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="9.5sp" android:textColor="#B1D6C1" android:fontFamily="monospace" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                <TextView android:id="@+id/item_button1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="32dp" android:minWidth="48dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:gravity="center" android:background="@drawable/monitor_button" android:text="DIAGNOSTICS" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.06" android:textColor="#13F580" android:fontFamily="monospace" android:maxLines="1" />
                <TextView android:id="@+id/item_button2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:minHeight="32dp" android:minWidth="48dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:gravity="center" android:background="@drawable/monitor_button" android:text="HISTORY" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.06" android:textColor="#13F580" android:fontFamily="monospace" android:maxLines="1" />
                <TextView android:id="@+id/item_button3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:minHeight="32dp" android:minWidth="48dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:gravity="center" android:background="@drawable/monitor_button" android:text="REPORT" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.06" android:textColor="#13F580" android:fontFamily="monospace" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
