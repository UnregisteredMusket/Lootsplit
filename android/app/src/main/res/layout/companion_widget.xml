<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/companion_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="4dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:background="@drawable/monitor_background" android:baselineAligned="false" android:gravity="center_vertical">
    <TextView android:id="@+id/companion_light" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/glyph_box_none" android:text="–" android:textSize="14sp" android:textStyle="bold" android:fontFamily="monospace" android:includeFontPadding="false" android:textColor="#B1D6C1" android:gravity="center" android:contentDescription="Owner sign-in needed" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_marginEnd="6dp" android:orientation="vertical" android:gravity="center_vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
            <TextView android:id="@+id/companion_first" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="13sp" android:textStyle="bold" android:fontFamily="monospace" android:textColor="#E6F8EC" android:text="Owner sign-in needed" android:contentDescription="OWNER · SIGN IN. Owner sign-in needed" />
            <Chronometer android:id="@+id/companion_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:includeFontPadding="false" android:maxLines="1" android:textSize="13sp" android:textStyle="bold" android:fontFamily="monospace" android:textColor="#13F580" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/companion_second" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:fontFamily="monospace" android:textColor="#B1D6C1" android:text="Tap to connect in My account" />
    </LinearLayout>
    <ImageView android:id="@+id/companion_action1" android:layout_width="44dp" android:layout_height="48dp" android:layout_marginEnd="4dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:scaleType="fitCenter" android:src="@drawable/ic_widget_refresh" android:background="@drawable/monitor_button" android:contentDescription="Refresh" />
    <ImageView android:id="@+id/companion_action2" android:layout_width="44dp" android:layout_height="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:scaleType="fitCenter" android:src="@drawable/ic_widget_settings" android:background="@drawable/monitor_button" android:contentDescription="Settings" />
</LinearLayout>
