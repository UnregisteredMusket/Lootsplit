<?xml version="1.0" encoding="utf-8"?>
<!-- One At a glance tile (Traffic, Deploys, Players). Compact: key, value, small chart or pips, note. Expanded (across both
     columns): the 24h/7d toggle on Traffic, a larger chart with its axis, and detail lines. Charts are bitmaps (WidgetCharts). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tile_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="vertical" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/item_tile_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
        <TextView android:id="@+id/tile_key" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="8.5sp" android:letterSpacing="0.08" android:textColor="#7AA68D" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/tile_seg_24h" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="24dp" android:minWidth="36dp" android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="24h" android:textSize="9sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:visibility="gone" />
        <TextView android:id="@+id/tile_seg_7d" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="24dp" android:minWidth="36dp" android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="7d" android:textSize="9sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:visibility="gone" />
        <TextView android:id="@+id/tile_chevron" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="▾" android:textSize="10sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:includeFontPadding="false" android:importantForAccessibility="no" />
    </LinearLayout>
    <TextView android:id="@+id/tile_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="12sp" android:textStyle="bold" android:textColor="#E6F8EC" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/tile_pips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.15" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:visibility="gone" />
    <ImageView android:id="@+id/tile_chart" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="3dp" android:scaleType="fitXY" android:visibility="gone" />
    <ImageView android:id="@+id/tile_chart_large" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="3dp" android:scaleType="fitXY" android:visibility="gone" />
    <LinearLayout android:id="@+id/tile_axis" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone" android:importantForAccessibility="no">
        <TextView android:id="@+id/tile_axis_start" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="8sp" android:textColor="#7AA68D" android:fontFamily="monospace" android:includeFontPadding="false" />
        <TextView android:id="@+id/tile_axis_mid" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textSize="8sp" android:textColor="#7AA68D" android:fontFamily="monospace" android:includeFontPadding="false" />
        <TextView android:id="@+id/tile_axis_end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="8sp" android:textColor="#7AA68D" android:fontFamily="monospace" android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout android:id="@+id/tile_days" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone" android:importantForAccessibility="no">
                <TextView android:id="@+id/tile_day0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textSize="8sp" android:textColor="#7AA68D" android:fontFamily="monospace" android:includeFontPadding="false" />
                <TextView android:id="@+id/tile_day1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textSize="8sp" android:textColor="#7AA68D" android:fontFamily="monospace" android:includeFontPadding="false" />
                <TextView android:id="@+id/tile_day2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textSize="8sp" android:textColor="#7AA68D" android:fontFamily="monospace" android:includeFontPadding="false" />
                <TextView android:id="@+id/tile_day3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textSize="8sp" android:textColor="#7AA68D" android:fontFamily="monospace" android:includeFontPadding="false" />
                <TextView android:id="@+id/tile_day4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textSize="8sp" android:textColor="#7AA68D" android:fontFamily="monospace" android:includeFontPadding="false" />
                <TextView android:id="@+id/tile_day5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textSize="8sp" android:textColor="#7AA68D" android:fontFamily="monospace" android:includeFontPadding="false" />
                <TextView android:id="@+id/tile_day6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textSize="8sp" android:textColor="#7AA68D" android:fontFamily="monospace" android:includeFontPadding="false" />
    </LinearLayout>
    <TextView android:id="@+id/tile_note1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="9sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/tile_note2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textSize="9sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
    <TextView android:id="@+id/tile_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="9.5sp" android:lineSpacingExtra="1dp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:visibility="gone" />
</LinearLayout>
