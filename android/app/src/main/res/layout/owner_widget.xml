<?xml version="1.0" ?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/monitor_background" android:padding="14dp">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/monitor_grid" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <TextView android:id="@+id/monitor_title" android:layout_width="match_parent" android:layout_height="20dp" android:text="LOOTSPLIT  /  FIELD MONITOR" android:textSize="12sp" android:textColor="#13F580" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/>
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="#395BECA0" android:importantForAccessibility="no"/>
        <LinearLayout android:id="@+id/monitor_account" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="vertical" android:gravity="center_vertical" android:contentDescription="Owner access. Open My account">
            <TextView android:id="@+id/monitor_identity" android:layout_width="match_parent" android:layout_height="20dp" android:text="OWNER ACCESS" android:textSize="12sp" android:textColor="#13F580" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/monitor_email" android:layout_width="match_parent" android:layout_height="18dp" android:text="Connect in My account" android:textSize="11sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/monitor_health" android:layout_width="match_parent" android:layout_height="30dp" android:text="CONNECT ACCOUNT" android:textSize="20sp" android:textColor="#EEC771" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp"/>
        <TextView android:id="@+id/monitor_services" android:visibility="gone" android:layout_width="match_parent" android:layout_height="18dp" android:text="Tap account to connect securely" android:textSize="11sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/monitor_active" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:text="—" android:textColor="#13F580" android:textSize="32sp" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical"/>
            <TextView android:layout_width="160dp" android:layout_height="44dp" android:text="ACCOUNT ACTIVITY\nPast 5 minutes" android:textColor="#B1D6C1" android:textSize="11sp" android:fontFamily="monospace" android:gravity="center_vertical|end"/>
        </LinearLayout>
        <TextView android:id="@+id/monitor_totals" android:layout_width="match_parent" android:layout_height="22dp" android:text="ACCOUNTS —    CAMPAIGNS —" android:textSize="11sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"/>
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="#395BECA0" android:importantForAccessibility="no"/>
        <LinearLayout android:id="@+id/monitor_details" android:visibility="gone" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:id="@+id/monitor_traffic_heading" android:layout_width="match_parent" android:layout_height="18dp" android:text="CLOUDFLARE TRAFFIC" android:textSize="12sp" android:textColor="#13F580" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/monitor_traffic" android:layout_width="match_parent" android:layout_height="20dp" android:text="Not connected" android:textSize="14sp" android:textColor="#E6F8EC" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/monitor_traffic_time" android:layout_width="match_parent" android:layout_height="16dp" android:text="LAST 24 HOURS" android:textSize="10sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/monitor_game_heading" android:layout_width="match_parent" android:layout_height="18dp" android:text="APP ANALYTICS" android:textSize="12sp" android:textColor="#13F580" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/monitor_game" android:layout_width="match_parent" android:layout_height="20dp" android:text="Unavailable" android:textSize="13sp" android:textColor="#E6F8EC" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/monitor_game_time" android:layout_width="match_parent" android:layout_height="16dp" android:text="SHARED CAMPAIGNS" android:textSize="10sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/monitor_backups" android:layout_width="match_parent" android:layout_height="18dp" android:text="CLOUD BACKUPS  —" android:textSize="11sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"/>
            <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="#395BECA0" android:importantForAccessibility="no"/>
        </LinearLayout>
        <TextView android:id="@+id/monitor_development" android:layout_width="match_parent" android:layout_height="22dp" android:text="Development unavailable" android:textSize="12sp" android:textColor="#13F580" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/monitor_deployment" android:visibility="gone" android:layout_width="match_parent" android:layout_height="22dp" android:text="Deployment unavailable" android:textSize="12sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/monitor_development_time" android:visibility="gone" android:layout_width="match_parent" android:layout_height="16dp" android:text="RECENT GITHUB ACTIVITY" android:textSize="10sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/monitor_release" android:visibility="gone" android:layout_width="match_parent" android:layout_height="20dp" android:text="WEB —  /  APP —" android:textSize="11sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/monitor_checked" android:layout_width="match_parent" android:layout_height="20dp" android:text="No current reading" android:textSize="10sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
            <TextView android:id="@+id/monitor_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/monitor_button" android:gravity="center" android:text="MY ACCOUNT" android:textSize="12sp" android:fontFamily="monospace" android:textColor="#13F580" android:contentDescription="MY ACCOUNT"/>
            <TextView android:id="@+id/monitor_refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/monitor_button" android:gravity="center" android:text="↻ REFRESH" android:textSize="12sp" android:fontFamily="monospace" android:textColor="#13F580" android:contentDescription="↻ REFRESH"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
