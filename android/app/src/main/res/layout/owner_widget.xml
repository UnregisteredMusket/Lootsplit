<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:id="@+id/monitor_root" xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/monitor_background" android:padding="10dp">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/monitor_grid" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <TextView android:id="@+id/monitor_title" android:layout_width="match_parent" android:layout_height="16dp" android:text="LOOTSPLIT / FIELD MONITOR" android:textSize="11sp" android:textColor="#13F580" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/>
        <LinearLayout android:id="@+id/monitor_account" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="vertical" android:gravity="center_vertical" android:contentDescription="Owner access. Open My account">
            <TextView android:id="@+id/monitor_identity" android:layout_width="match_parent" android:layout_height="20dp" android:text="OWNER ACCESS" android:textSize="12sp" android:textColor="#13F580" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/monitor_email" android:layout_width="match_parent" android:layout_height="16dp" android:text="Tap Sign in" android:textSize="10sp" android:textColor="#B1D6C1" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/monitor_health" android:layout_width="match_parent" android:layout_height="24dp" android:text="SIGN IN REQUIRED" android:textSize="16sp" android:textColor="#EEC771" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp"/>
        <TextView android:id="@+id/monitor_services" android:layout_width="match_parent" android:layout_height="26dp" android:text="Backend logging continues independently" android:textSize="10sp" android:textColor="#B1D6C1" android:maxLines="2" android:ellipsize="end"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal">
            <TextView android:id="@+id/monitor_active" android:layout_width="40dp" android:layout_height="22dp" android:text="—" android:textColor="#13F580" android:textSize="18sp" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/monitor_totals" android:layout_width="0dp" android:layout_weight="1" android:layout_height="22dp" android:text="ACCOUNT ACTIVITY · 5 MINUTES" android:textSize="10sp" android:textColor="#B1D6C1" android:maxLines="2" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/monitor_development" android:layout_width="match_parent" android:layout_height="28dp" android:text="No development task active" android:textSize="11sp" android:textColor="#E6F8EC" android:maxLines="2" android:ellipsize="end"/>
        <Chronometer android:id="@+id/monitor_timer" android:layout_width="match_parent" android:layout_height="18dp" android:textSize="11sp" android:textColor="#13F580" android:visibility="gone"/>
        <LinearLayout android:id="@+id/monitor_details" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
            <ListView android:id="@+id/monitor_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="#395BECA0" android:dividerHeight="1dp" android:scrollbars="vertical" android:contentDescription="Scrollable owner monitoring entries, diagnostics and reports"/>
        </LinearLayout>
        <TextView android:id="@+id/monitor_checked" android:layout_width="match_parent" android:layout_height="18dp" android:text="No current reading" android:textSize="9sp" android:textColor="#B1D6C1" android:maxLines="1" android:ellipsize="end"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
            <TextView android:id="@+id/monitor_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginEnd="4dp" android:background="@drawable/monitor_button" android:gravity="center" android:text="LOGS / REPORTS" android:textSize="11sp" android:textColor="#13F580"/>
            <TextView android:id="@+id/monitor_refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:background="@drawable/monitor_button" android:gravity="center" android:text="↻ REFRESH" android:textSize="12sp" android:textColor="#13F580" android:contentDescription="Refresh owner monitoring"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
