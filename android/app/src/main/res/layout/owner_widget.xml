<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:id="@+id/monitor_root" xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/monitor_background" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="10dp">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/monitor_grid" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

        <!-- 1. Header: title left, reading time right -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="16dp" android:layout_marginBottom="6dp" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
            <TextView android:id="@+id/monitor_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="16dp" android:text="LOOTSPLIT ▸ FIELD MONITOR" android:textSize="11sp" android:textColor="#13F580" android:fontFamily="monospace" android:textStyle="bold" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/monitor_checked" android:layout_width="wrap_content" android:layout_height="16dp" android:layout_marginStart="6dp" android:text="—" android:contentDescription="No current reading" android:textSize="10sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center_vertical|end" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- 2. Status block: glyph box + status word, then one reason line -->
        <LinearLayout android:id="@+id/monitor_status" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="6dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
                <TextView android:id="@+id/monitor_glyph" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="8dp" android:background="@drawable/glyph_box_none" android:text="–" android:textSize="12sp" android:textStyle="bold" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center" android:includeFontPadding="false" android:importantForAccessibility="no"/>
                <TextView android:id="@+id/monitor_health" android:layout_width="0dp" android:layout_weight="1" android:layout_height="28dp" android:text="SIGN IN REQUIRED" android:textSize="18sp" android:textColor="#EEC771" android:fontFamily="monospace" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp"/>
            </LinearLayout>
            <TextView android:id="@+id/monitor_services" android:layout_width="match_parent" android:layout_height="16dp" android:text="Tap Sign in to connect your owner account" android:textSize="11sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- 3. Stats strip: four equal tiles -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginBottom="6dp" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:id="@+id/monitor_tile_active" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="4dp" android:background="@drawable/stat_tile" android:orientation="vertical" android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp">
                <TextView android:id="@+id/monitor_active" android:layout_width="match_parent" android:layout_height="22dp" android:text="—" android:textSize="17sp" android:textStyle="bold" android:textColor="#13F580" android:fontFamily="monospace" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="17sp" android:autoSizeStepGranularity="1sp"/>
                <TextView android:id="@+id/monitor_active_label" android:layout_width="match_parent" android:layout_height="12dp" android:text="ACTIVE 5M" android:textSize="9sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/monitor_tile_accounts" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="4dp" android:background="@drawable/stat_tile" android:orientation="vertical" android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp">
                <TextView android:id="@+id/monitor_accounts" android:layout_width="match_parent" android:layout_height="22dp" android:text="—" android:textSize="17sp" android:textStyle="bold" android:textColor="#13F580" android:fontFamily="monospace" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="17sp" android:autoSizeStepGranularity="1sp"/>
                <TextView android:id="@+id/monitor_accounts_label" android:layout_width="match_parent" android:layout_height="12dp" android:text="ACCOUNTS" android:textSize="9sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/monitor_tile_campaigns" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="4dp" android:background="@drawable/stat_tile" android:orientation="vertical" android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp">
                <TextView android:id="@+id/monitor_campaigns" android:layout_width="match_parent" android:layout_height="22dp" android:text="—" android:textSize="17sp" android:textStyle="bold" android:textColor="#13F580" android:fontFamily="monospace" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="17sp" android:autoSizeStepGranularity="1sp"/>
                <TextView android:id="@+id/monitor_campaigns_label" android:layout_width="match_parent" android:layout_height="12dp" android:text="CAMPAIGNS" android:textSize="9sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/monitor_tile_requests" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:background="@drawable/stat_tile" android:orientation="vertical" android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp">
                <TextView android:id="@+id/monitor_requests" android:layout_width="match_parent" android:layout_height="22dp" android:text="—" android:textSize="17sp" android:textStyle="bold" android:textColor="#13F580" android:fontFamily="monospace" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="17sp" android:autoSizeStepGranularity="1sp"/>
                <TextView android:id="@+id/monitor_requests_label" android:layout_width="match_parent" android:layout_height="12dp" android:text="REQ · 24H" android:textSize="9sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 4. Task strip: state/phase + elapsed timer, then warning or progress -->
        <LinearLayout android:id="@+id/monitor_task" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/task_card" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:contentDescription="Development task. Open task details">
            <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
                <TextView android:id="@+id/monitor_development" android:layout_width="0dp" android:layout_weight="1" android:layout_height="18dp" android:text="No development task active" android:textSize="11sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
                <Chronometer android:id="@+id/monitor_timer" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_marginStart="6dp" android:textSize="12sp" android:textStyle="bold" android:textColor="#13F580" android:fontFamily="monospace" android:gravity="center_vertical|end" android:includeFontPadding="false" android:maxLines="1" android:visibility="gone"/>
            </LinearLayout>
            <TextView android:id="@+id/monitor_task_detail" android:layout_width="match_parent" android:layout_height="16dp" android:textSize="10sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
        </LinearLayout>

        <!-- 5. Log label + rule, then the scrolling collection -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginBottom="2dp" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
            <TextView android:id="@+id/monitor_list_label" android:layout_width="wrap_content" android:layout_height="14dp" android:layout_marginEnd="8dp" android:text="LOG" android:textSize="9sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1"/>
            <FrameLayout android:id="@+id/monitor_list_rule" android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" android:background="#405BECA0" android:importantForAccessibility="no"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/monitor_details" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
            <ListView android:id="@+id/monitor_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="#245BECA0" android:dividerHeight="1dp" android:scrollbars="vertical" android:contentDescription="Scrollable owner monitoring entries, diagnostics and reports"/>
        </LinearLayout>

        <!-- 6. Footer: identity, LOGS, REFRESH -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/monitor_account" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginEnd="6dp" android:orientation="vertical" android:gravity="center_vertical" android:contentDescription="Owner access. Open My account">
                <TextView android:id="@+id/monitor_identity" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OWNER · SIGN IN" android:textSize="9sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <TextView android:id="@+id/monitor_open" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="48dp" android:layout_marginEnd="6dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/monitor_button" android:gravity="center" android:text="LOGS" android:textSize="11sp" android:textStyle="bold" android:textColor="#13F580" android:fontFamily="monospace" android:maxLines="1" android:contentDescription="Open logs and reports"/>
            <TextView android:id="@+id/monitor_refresh" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/monitor_button" android:gravity="center" android:text="↻ REFRESH" android:textSize="11sp" android:textStyle="bold" android:textColor="#13F580" android:fontFamily="monospace" android:maxLines="1" android:contentDescription="Refresh owner monitoring"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
