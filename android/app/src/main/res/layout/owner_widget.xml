<?xml version="1.0" encoding="utf-8"?>
<!-- Field monitor 4×4 (redesign approved 2026-10-25): fixed header and status, then one scrolling list: Needs attention,
     Recently resolved (24 h), At a glance tiles, the report/agent strip and More (every earlier row). Footer: identity, LOGS, REFRESH. -->
<FrameLayout android:id="@+id/monitor_root" xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/monitor_background" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="8dp">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/monitor_grid" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

        <!-- 1. Header: title left, reading time right -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="16dp" android:layout_marginBottom="6dp" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
            <TextView android:id="@+id/monitor_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="LOOTSPLITTER ▸ FIELD MONITOR" android:textSize="11sp" android:textColor="#13F580" android:fontFamily="monospace" android:textStyle="bold" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/monitor_checked" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="—" android:contentDescription="No current reading" android:textSize="10sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center_vertical|end" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- Status: glyph box, status word with "since 10:41 · active 31m", severity counts (✕ ! i; a zero count is dimmed) and ›.
             The block opens Diagnostics; each count opens Diagnostics showing that severity (44 dp tall targets). -->
        <LinearLayout android:id="@+id/monitor_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
            <TextView android:id="@+id/monitor_glyph" android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/glyph_box_none" android:text="–" android:textSize="16sp" android:textStyle="bold" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center" android:includeFontPadding="false" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:orientation="vertical">
                <TextView android:id="@+id/monitor_health" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SIGN IN REQUIRED" android:textSize="17sp" android:textColor="#EEC771" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:letterSpacing="0.03"/>
                <TextView android:id="@+id/monitor_since" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textSize="10sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/monitor_counts" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:orientation="horizontal">
                <TextView android:id="@+id/monitor_count_crit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="44dp" android:minWidth="40dp" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:background="@drawable/chip_tap" android:text="✕–" android:textSize="10sp" android:textStyle="bold" android:textColor="#F47272" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" />
                <TextView android:id="@+id/monitor_count_warn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="44dp" android:minWidth="40dp" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:background="@drawable/chip_tap" android:text="!–" android:textSize="10sp" android:textStyle="bold" android:textColor="#EEC771" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" />
                <TextView android:id="@+id/monitor_count_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="44dp" android:minWidth="40dp" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:background="@drawable/chip_tap" android:text="i–" android:textSize="10sp" android:textStyle="bold" android:textColor="#8CC4F2" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/monitor_status_more" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:text="›" android:textSize="18sp" android:textStyle="bold" android:textColor="#B1D6C1" android:fontFamily="monospace" android:includeFontPadding="false" android:importantForAccessibility="no"/>
        </LinearLayout>
        <TextView android:id="@+id/monitor_services" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Tap Sign in to connect your owner account" android:textSize="11sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>

        <!-- 3. The scrolling list (RemoteCollectionItems on API 31+, RemoteViewsService on API 24–30). -->
        <LinearLayout android:id="@+id/monitor_details" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="2dp" android:orientation="vertical">
            <ListView android:id="@+id/monitor_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:dividerHeight="0dp" android:scrollbars="vertical" android:contentDescription="Scrollable owner monitoring: attention items, recent recoveries, charts, logs, diagnostics and reports"/>
        </LinearLayout>

        <!-- 4. Footer: identity, LOGS, REFRESH -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/monitor_account" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginEnd="6dp" android:orientation="vertical" android:gravity="center_vertical" android:contentDescription="Owner access. Open My account">
                <TextView android:id="@+id/monitor_identity" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OWNER · SIGN IN" android:textSize="10sp" android:textColor="#B1D6C1" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <TextView android:id="@+id/monitor_open" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="48dp" android:layout_marginEnd="6dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/monitor_button" android:gravity="center" android:text="LOGS" android:textSize="11sp" android:textStyle="bold" android:textColor="#13F580" android:fontFamily="monospace" android:maxLines="1" android:contentDescription="Open logs and reports"/>
            <TextView android:id="@+id/monitor_refresh" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/monitor_button" android:gravity="center" android:text="↻ REFRESH" android:textSize="11sp" android:textStyle="bold" android:textColor="#13F580" android:fontFamily="monospace" android:maxLines="1" android:contentDescription="Refresh owner monitoring"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
