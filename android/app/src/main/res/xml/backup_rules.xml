<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6–11 (API 23–30) Auto Backup. Excludes the whole WebView storage directory: its
     localStorage holds the 30-day native account bearer token and cannot be split per key.
     The same directory holds WebView localStorage/IndexedDB campaign data, so device-local
     campaigns rely on the app's own exports/device backups rather than Android Auto Backup.
     Other app files and shared preferences keep their existing backup. Widget credentials
     live in noBackupFilesDir, which Android never backs up. -->
<full-backup-content>
    <exclude domain="root" path="app_webview/" />
</full-backup-content>
