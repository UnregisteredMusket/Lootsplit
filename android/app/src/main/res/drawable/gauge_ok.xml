<?xml version="1.0" encoding="utf-8"?>
<!-- Plan-usage gauge. Mid-tone colours keep at least 3:1 against both the terminal and the parchment tiles. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background"><shape><corners android:radius="3dp" /><solid android:color="#668C8C8C" /></shape></item>
    <item android:id="@android:id/progress"><clip><shape><corners android:radius="3dp" /><solid android:color="#3C9A6A" /></shape></clip></item>
</layer-list>
