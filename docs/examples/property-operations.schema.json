{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "lootsplit.property-operations"
    },
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "const": "draft"
    },
    "currency": {
      "const": "copper"
    },
    "timeUnit": {
      "const": "campaign-day"
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "region",
              "city",
              "town",
              "area"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "parentKey": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
          }
        },
        "required": [
          "key",
          "kind",
          "name",
          "parentKey"
        ]
      },
      "minItems": 0,
      "maxItems": 500
    },
    "ownerBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "party",
              "character"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "key",
          "kind",
          "label"
        ]
      },
      "minItems": 0,
      "maxItems": 500
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "key",
          "name",
          "unit"
        ]
      },
      "minItems": 0,
      "maxItems": 500
    },
    "templates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/template"
      },
      "minItems": 1,
      "maxItems": 500
    },
    "properties": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/property"
      },
      "minItems": 1,
      "maxItems": 500
    },
    "postalDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feeCopper": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "deliveryDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        }
      },
      "required": [
        "feeCopper",
        "deliveryDays"
      ]
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "status",
    "currency",
    "timeUnit",
    "locations",
    "ownerBindings",
    "materials",
    "templates",
    "properties"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Proposed Lootsplit property-operations import v1 (not supported by the current app)",
  "description": "Documentation only. Cross-reference, hierarchy, ownership, stale-state and permission checks are required separately. Importing must not activate operations or fabricate transactions.",
  "definitions": {
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultAccess": {
          "type": "string",
          "enum": [
            "party-members",
            "owner"
          ]
        },
        "capacityWeight": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000
        }
      },
      "required": [
        "defaultAccess",
        "capacityWeight"
      ]
    },
    "rental": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "incomeCopper": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "upkeepCopper": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "periodDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        }
      },
      "required": [
        "incomeCopper",
        "upkeepCopper",
        "periodDays"
      ]
    },
    "staff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "minimum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "wageCopper": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "periodDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "purpose": {
          "type": "string",
          "enum": [
            "operation",
            "automation"
          ]
        }
      },
      "required": [
        "role",
        "minimum",
        "wageCopper",
        "periodDays",
        "purpose"
      ]
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "resultTemplateKey": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "laborDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "laborCostCopper": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "materialKey": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000
              }
            },
            "required": [
              "materialKey",
              "quantity"
            ]
          },
          "minItems": 0,
          "maxItems": 500
        }
      },
      "required": [
        "key",
        "name",
        "resultTemplateKey",
        "laborDays",
        "laborCostCopper",
        "materials"
      ]
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "propertyType": {
          "type": "string",
          "enum": [
            "residence",
            "inn",
            "keep",
            "tower",
            "homestead",
            "workshop",
            "land",
            "other"
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "storage",
              "rental",
              "construction-site",
              "trade",
              "crafting",
              "lodging",
              "farming",
              "extraction",
              "stabling",
              "postal",
              "research",
              "training",
              "healing",
              "administration",
              "defense",
              "transport"
            ]
          }
        },
        "storage": {
          "$ref": "#/definitions/storage"
        },
        "rental": {
          "$ref": "#/definitions/rental"
        },
        "staff": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/staff"
          },
          "minItems": 0,
          "maxItems": 500
        },
        "recipes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/recipe"
          },
          "minItems": 0,
          "maxItems": 500
        }
      },
      "required": [
        "key",
        "name",
        "propertyType",
        "capabilities"
      ]
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "recordKind": {
          "type": "string",
          "enum": [
            "listing",
            "holding"
          ]
        },
        "templateKey": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "locationKey": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "parentPropertyKey": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "condition": {
          "type": "string",
          "enum": [
            "ready",
            "maintained",
            "repairs",
            "ruin"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        },
        "ownerKey": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "priceCopper": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "valueCopper": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "reserved",
            "withdrawn"
          ]
        }
      },
      "required": [
        "key",
        "name",
        "recordKind",
        "templateKey",
        "locationKey",
        "condition",
        "notes"
      ],
      "oneOf": [
        {
          "properties": {
            "recordKind": {
              "const": "listing"
            }
          },
          "required": [
            "priceCopper",
            "status"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "ownerKey"
                ]
              },
              {
                "required": [
                  "valueCopper"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "recordKind": {
              "const": "holding"
            }
          },
          "required": [
            "ownerKey",
            "valueCopper"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "priceCopper"
                ]
              },
              {
                "required": [
                  "status"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
