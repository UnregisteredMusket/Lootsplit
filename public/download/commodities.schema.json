{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lootsplit commodity definitions, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "commodities"],
  "properties": {
    "version": { "const": 1 },
    "commodities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "unit", "category", "baseCopper", "weight", "active"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "unit": { "type": "string", "minLength": 1, "maxLength": 160 },
          "category": {
            "enum": [
              "provisions",
              "smith",
              "cloth",
              "apothecary",
              "inn",
              "general",
              "curios",
              "stable",
              "scribe",
              "jewels"
            ]
          },
          "baseCopper": { "type": "integer", "minimum": 1, "maximum": 1000000000000 },
          "weight": { "type": "number", "minimum": 0, "maximum": 9999 },
          "active": { "type": "boolean" },
          "description": { "type": "string", "maxLength": 4000 },
          "materialKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" }
        }
      }
    }
  }
}
